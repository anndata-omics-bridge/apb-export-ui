{
 "software": [
  "AlphaDIA",
  "AlphaPept",
  "DIA-NN",
  "FragPipe",
  "i2MassChroQ",
  "MaxQuant",
  "MetaMorpheus",
  "MSAngel",
  "pb_custom",
  "PEAKS",
  "ProlineStudio",
  "quantms",
  "Sage",
  "Spectronaut",
  "WOMBAT-P"
 ],
 "hints": {
  "source": "each tool's own documentation and source code, October 2026",
  "annotation": "an SDRF whose comment[data file] column names the raw files, or a prolfquapp CSV/TSV with a raw-file column and one column per factor",
  "software": {
   "AlphaDIA": {
    "sources": [
     "https://github.com/MannLabs/alphadia/blob/main/docs/methods/output-format.md",
     "https://github.com/MannLabs/alphadia/releases/tag/v2.0.0",
     "https://github.com/MannLabs/alphadia/blob/v1.10.4/alphadia/outputtransform.py"
    ],
    "exports": [
     {
      "rules": [
       "alphadia/v2/rules.json"
      ],
      "versions": "2.x",
      "result": [
       "precursors.parquet"
      ],
      "params": "log.txt",
      "kinds": [
       ".parquet"
      ],
      "note": "Both in the output folder. With file_format: tsv AlphaDIA writes precursors.tsv instead, which this converter does not read."
     },
     {
      "rules": [
       "alphadia/v1_12/rules.json"
      ],
      "versions": "1.12",
      "result": [
       "precursors.tsv",
       "precursor.matrix.tsv"
      ],
      "params": "log.txt",
      "kinds": [
       ".tsv"
      ],
      "note": "Two tables from the output folder; upload both. Intensities come from precursor.matrix.tsv, which needs Precursor Level LFQ; precursors.tsv alone holds only protein-group intensities and is refused."
     }
    ]
   },
   "AlphaPept": {
    "sources": [
     "https://mannlabs.github.io/alphapept/file_formats.html",
     "https://github.com/MannLabs/alphapept/blob/master/alphapept/interface.py"
    ],
    "exports": [
     {
      "rules": [
       "alphapept/rules.json"
      ],
      "versions": "0.5",
      "result": [
       "results_peptides.csv"
      ],
      "params": "results.yaml",
      "kinds": [
       ".csv",
       ".txt"
      ],
      "note": "Beside results.hdf. Setting results_path renames them to <stem>_peptides.csv and <stem>.yaml; the yaml written after the run carries the version."
     }
    ]
   },
   "DIA-NN": {
    "sources": [
     "https://github.com/vdemichev/DiaNN",
     "https://github.com/vdemichev/DiaNN/blob/ce0549614d/README.md",
     "https://github.com/vdemichev/DiaNN/blob/601b76f644/README.md"
    ],
    "exports": [
     {
      "rules": [
       "diann/v2/rules.json"
      ],
      "versions": "2.x",
      "result": [
       "report.parquet"
      ],
      "params": "report.log.txt",
      "kinds": [
       ".parquet"
      ],
      "note": "Default names: Main output (--out) renames both, e.g. x.parquet and x.log.txt. Not report.pr_matrix.tsv, report.pg_matrix.tsv or report.stats.tsv."
     },
     {
      "rules": [
       "diann/v1_8/rules.json"
      ],
      "versions": "1.9 (Parquet)",
      "result": [
       "report.parquet"
      ],
      "params": "report.log.txt",
      "kinds": [
       ".parquet"
      ],
      "note": "1.9 also writes the legacy report.tsv; either works."
     },
     {
      "rules": [
       "diann/v1_7/rules.json",
       "diann/v1_8/rules.json"
      ],
      "versions": "1.9 and earlier (TSV)",
      "result": [
       "report.tsv"
      ],
      "params": "report.log.txt",
      "kinds": [
       ".tsv",
       ".txt"
      ],
      "note": "Default names: --out renames both, e.g. x.tsv and x.log.txt."
     }
    ]
   },
   "FragPipe": {
    "sources": [
     "https://fragpipe.nesvilab.org/docs/tutorial_fragpipe_outputs.html",
     "https://github.com/Nesvilab/FragPipe/blob/23.1/FragPipe-GUI/src/main/java/org/nesvilab/fragpipe/cmd/CmdDiann.java",
     "https://github.com/Nesvilab/FragPipe/blob/23.1/FragPipe-GUI/src/main/java/org/nesvilab/fragpipe/FragpipeRun.java"
    ],
    "exports": [
     {
      "rules": [
       "fragpipe/rules.json"
      ],
      "versions": "22\u201323, DDA with IonQuant",
      "result": [
       "combined_ion.tsv"
      ],
      "params": "fragpipe.workflow",
      "kinds": [
       ".tsv"
      ],
      "note": "Both at the output folder root. combined_ion.tsv needs runs assigned to experiments, as the LFQ-MBR workflow does."
     },
     {
      "rules": [
       "diann/v1_8/rules.json"
      ],
      "versions": "23 and later, DIA with DIA-NN quant",
      "labels": [
       "FragPipe (DIA-NN quant)"
      ],
      "result": [
       "dia-quant-output/report.tsv"
      ],
      "params": "fragpipe.workflow",
      "kinds": [
       ".tsv"
      ],
      "note": "FragPipe 21\u201322 write diann-output/report.tsv, 19\u201320 diann-output/diann-output.tsv."
     }
    ]
   },
   "i2MassChroQ": {
    "sources": [
     "https://forge.inrae.fr/pappso/i2masschroq/-/blob/main/src/gui/run/mcqr/mcqrrunviewng.cpp",
     "https://forge.inrae.fr/pappso/i2masschroq/-/blob/main/debian/changelog"
    ],
    "exports": [
     {
      "rules": [
       "i2masschroq/rules.json"
      ],
      "versions": "1.x",
      "result": [
       "proteobench_export.tsv"
      ],
      "params": "Project parameters.tsv",
      "kinds": [
       ".tsv",
       ".txt"
      ],
      "note": "The ProteoBench export button in the MCQR view, after Normalisation and PCA, saves <project name>.zip holding both files; unzip it and upload them."
     }
    ]
   },
   "MaxQuant": {
    "sources": [
     "https://cox-labs.github.io/coxdocs/MQ_FirstSteps.html",
     "https://cox-labs.github.io/coxdocs/output_tables.html",
     "https://maxquant.org/static/main/pdf/Linux_MQ_Installation.pdf"
    ],
    "exports": [
     {
      "rules": [
       "maxquant/rules.json",
       "maxquant_wide/rules.json"
      ],
      "versions": "1.5\u20132.x",
      "result": [
       "combined/txt/evidence.txt"
      ],
      "params": "mqpar.xml",
      "kinds": [
       ".txt"
      ],
      "note": "MaxDIA writes the same evidence.txt. mqpar.xml is written to the raw-file folder; a renamed copy works too."
     },
     {
      "rules": [
       "maxquant_wide/rules.json"
      ],
      "versions": "1.5\u20132.x, whole txt folder",
      "result": [
       "combined/txt/"
      ],
      "params": "mqpar.xml",
      "kinds": [
       "folder"
      ],
      "note": "evidence.txt, peptides.txt and proteinGroups.txt read together. The browser cannot upload a folder yet; examples only."
     }
    ]
   },
   "MetaMorpheus": {
    "sources": [
     "https://github.com/smith-chem-wisc/MetaMorpheus/blob/master/MetaMorpheus/TaskLayer/SearchTask/PostSearchAnalysisTask.cs",
     "https://github.com/smith-chem-wisc/MetaMorpheus/blob/master/MetaMorpheus/TaskLayer/MetaMorpheusTask.cs",
     "https://github.com/smith-chem-wisc/MetaMorpheus/wiki/Quantification"
    ],
    "exports": [
     {
      "rules": [
       "metamorpheus/rules.json"
      ],
      "versions": "1.0.7 and later",
      "result": [
       "Task1-SearchTask/AllQuantifiedPeaks.tsv"
      ],
      "params": "Task Settings/<task>config.toml + allResults.txt",
      "kinds": [
       ".tsv"
      ],
      "note": "Default GUI task folder; the command line writes Task1SearchTask without the hyphen. Not AllQuantifiedPeptides.tsv or the per-run *_QuantifiedPeaks.tsv. The two parameter files cannot be uploaded here yet, so convert from the result alone; the prolfqua output waits for apb-catalog to review MetaMorpheus."
     }
    ]
   },
   "MSAngel": {
    "sources": [
     "https://profiproteomics.fr/download/ms-angel-user-guide-instructions/",
     "https://github.com/profiproteomics/proline-server/blob/master/pm-dataset-exporter/src/main/scala/fr/proline/module/exporter/commons/config/ExportConfigSheet.scala"
    ],
    "exports": [
     {
      "rules": [
       "msangel/rules.json"
      ],
      "versions": "2.x",
      "result": [
       "<name>.xlsx"
      ],
      "params": "<name>-export-param.json",
      "kinds": [
       ".xlsx",
       ".txt"
      ],
      "note": "Proline's Excel export of the quantification, with its Quantified peptide ions sheet and, for the protein level, its Protein sets sheet, plus MS-Angel's exported workflow JSON. MS-Angel documents neither name."
     }
    ]
   },
   "pb_custom": {
    "sources": [
     "https://github.com/Proteobench/ProteoBench/blob/main/docs/modules/dda/dda-ion-qexactive.md"
    ],
    "exports": [
     {
      "rules": [
       "pb_custom/rules.json"
      ],
      "versions": "any",
      "result": [
       "custom_input.tsv"
      ],
      "params": null,
      "kinds": [
       ".tsv",
       ".txt"
      ],
      "note": "ProteoBench's own tab-separated format for tools without a parser."
     }
    ]
   },
   "PEAKS": {
    "sources": [
     "https://www.bioinfor.com/wp-content/uploads/2017/08/PEAKS_Studio_85_Manual.pdf",
     "https://github.com/Proteobench/ProteoBench/blob/main/docs/modules/dda/dda-ion-qexactive.md"
    ],
    "exports": [
     {
      "rules": [
       "peaks/rules.json"
      ],
      "versions": "13",
      "result": [
       "*.features.csv"
      ],
      "params": "*.txt",
      "kinds": [
       ".csv"
      ],
      "note": "The Label Free Quantification Feature Vector CSV, e.g. lfq.features.csv (DDA) or lfq.dia.features.csv (DIA), and the All Search Parameters text export; PEAKS documentation gives no default names."
     }
    ]
   },
   "ProlineStudio": {
    "sources": [
     "https://profiproteomics.fr/software/doc/2.3/",
     "https://github.com/profiproteomics/proline-server/blob/master/pm-dataset-exporter/src/main/scala/fr/proline/module/exporter/commons/config/ExportConfigSheet.scala"
    ],
    "exports": [
     {
      "rules": [
       "prolinestudio/rules.json"
      ],
      "versions": "2.x",
      "result": [
       "<name>.xlsx"
      ],
      "params": "<name>.xlsx, the result file itself",
      "kinds": [
       ".xlsx",
       ".txt"
      ],
      "note": "Export > Excel\u2026 with a custom export: enable the Quantified peptide ions sheet with its samesets_accessions, subsets_accessions and protein_set_score columns; the sheet and both accession columns are off by default. Its settings sheets are the parameters."
     }
    ]
   },
   "quantms": {
    "sources": [
     "https://github.com/bigbio/quantms/blob/1.3.0/modules/local/openms/proteomicslfq/main.nf",
     "https://github.com/bigbio/quantms/blob/1.10.0/workflows/quantms.nf"
    ],
    "exports": [
     {
      "rules": [
       "quantms/rules.json"
      ],
      "versions": "1.x",
      "result": [
       "quant_tables/<sdrf name>_openms_design_msstats_in.csv"
      ],
      "params": "pipeline_info/nf_core_quantms_software_mqc_versions.yml",
      "kinds": [
       ".csv"
      ],
      "note": "Up to 1.4 the table is in proteomicslfq/; nf-core/quantms 1.0 wrote out_msstats.csv. This converter reads the software-versions YAML, not params_<timestamp>.json."
     }
    ]
   },
   "Sage": {
    "params_required": true,
    "sources": [
     "https://sage-docs.vercel.app/docs/results",
     "https://sage-docs.vercel.app/docs/configuration"
    ],
    "exports": [
     {
      "rules": [
       "sage/rules.json"
      ],
      "versions": "0.x",
      "result": [
       "lfq.tsv"
      ],
      "params": "results.json",
      "kinds": [
       ".tsv"
      ],
      "note": "Both in output_directory. results.sage.tsv is the PSM table, not this one; lfq.parquet (--parquet) is not read. Your own config file has no version: upload results.json."
     }
    ]
   },
   "Spectronaut": {
    "sources": [
     "https://files.biognosys.ch/Tutorials/Command_Line_Use_in_Spectronaut.pdf",
     "https://www.ebi.ac.uk/pride/ws/archive/v3/projects/PXD054445/files/all",
     "https://www.ebi.ac.uk/pride/ws/archive/v3/projects/PXD023834/files/all"
    ],
    "exports": [
     {
      "rules": [
       "spectronaut/v15/rules.json",
       "spectronaut/rules.json",
       "spectronaut/v21/rules.json"
      ],
      "versions": "15, 19\u201321",
      "result": [
       "<report name>.tsv"
      ],
      "params": "<report name>.setup.txt",
      "kinds": [
       ".tsv"
      ],
      "note": "A Normal-format BGS Factory Report, named when you export it; Spectronaut writes the .setup.txt beside it. Pipeline runs write <Experiment>_ExperimentSetupOverview_<schema>.txt instead; either works."
     }
    ]
   },
   "WOMBAT-P": {
    "sources": [
     "https://github.com/wombat-p/WOMBAT-Pipelines/blob/0.9.11/modules/local/calcbenchmarks/main.nf",
     "https://github.com/wombat-p/WOMBAT-Pipelines/blob/0.9.11/modules/local/prepare_files/main.nf"
    ],
    "exports": [
     {
      "rules": [
       "wombat/rules.json"
      ],
      "versions": "0.9.11",
      "result": [
       "stand_ion_quant_merged<workflow>.csv"
      ],
      "params": "prepare_files/params.yml",
      "kinds": [
       ".csv"
      ],
      "note": "In the results folder, e.g. stand_ion_quant_mergedproline.csv; the stand_pep_quant files lack charges. This converter accepts params.yml reporting version 0.9.11 only."
     }
    ]
   }
  }
 },
 "outputs": [
  {
   "id": "apb-export:alphapepttools",
   "label": "alphapepttools (.h5mu)",
   "command": "apb-export",
   "name": "alphapepttools",
   "extension": ".h5mu",
   "annotation": true,
   "fasta": true,
   "about": {
    "title": "AlphaPeptTools",
    "file": ".h5mu",
    "what": "Ion, peptide and protein levels as wide modalities linked by their ids.",
    "open": "alphapepttools.io.mulink_from_anndatas on mudata.read_h5mu(path)",
    "version": "0.4",
    "links": [
     {
      "label": "MannLabs/alphapepttools",
      "url": "https://github.com/MannLabs/alphapepttools"
     }
    ],
    "group": "tool"
   },
   "levels": [
    "peptidoform_ion",
    "peptide",
    "protein"
   ]
  },
  {
   "id": "apb-export:explorede",
   "label": "explorede (.h5ads)",
   "command": "apb-export",
   "name": "explorede",
   "extension": ".h5ads",
   "annotation": true,
   "fasta": true,
   "about": {
    "title": "exploreDE",
    "file": ".h5ad per level",
    "what": "One exploreDE file per level the result holds (protein, peptide, precursor), log2 intensities, without differential expression; SDRF factor values and prolfquapp group columns become its groupings.",
    "open": "Open in exploreDE, or R: exploreDE::exploreDE(path)",
    "version": "1.0",
    "links": [
     {
      "label": "fgcz/exploreDE",
      "url": "https://github.com/fgcz/exploreDE"
     }
    ],
    "group": "tool",
    "viewer": "exploreDE"
   },
   "levels": [
    "protein",
    "peptide",
    "peptidoform_ion"
   ]
  },
  {
   "id": "apb-export:msmu",
   "label": "msmu (.h5mu)",
   "command": "apb-export",
   "name": "msmu",
   "extension": ".h5mu",
   "annotation": false,
   "fasta": true,
   "about": {
    "title": "msmu",
    "file": ".h5mu",
    "what": "msmu's psm modality, precursors by runs; experimental.",
    "open": "msmu.read_h5mu(path)",
    "version": "0.4",
    "links": [
     {
      "label": "bertis-informatics/msmu",
      "url": "https://github.com/bertis-informatics/msmu"
     }
    ],
    "group": "tool"
   },
   "levels": [
    "peptidoform_ion"
   ]
  },
  {
   "id": "apb-export:msstats",
   "label": "msstats (.csv)",
   "command": "apb-export",
   "name": "msstats",
   "extension": ".csv",
   "annotation": true,
   "fasta": true,
   "about": {
    "title": "MSstats",
    "file": ".csv",
    "what": "Long table, one row per precursor and run, with MSstats' column names; Condition and BioReplicate come from the sample annotation.",
    "open": "R: MSstats::dataProcess(read.csv(path))",
    "version": "4.20",
    "links": [
     {
      "label": "Vitek-Lab/MSstats",
      "url": "https://github.com/Vitek-Lab/MSstats"
     }
    ],
    "group": "tool"
   },
   "levels": [
    "peptidoform_ion"
   ]
  },
  {
   "id": "apb-export:perseus",
   "label": "perseus (.txt)",
   "command": "apb-export",
   "name": "perseus",
   "extension": ".txt",
   "annotation": true,
   "fasta": true,
   "about": {
    "title": "Perseus",
    "file": ".txt",
    "what": "Protein groups with proteinGroups.txt's column names; sample columns typed main, annotation columns as categorical rows.",
    "open": "Perseus: Generic matrix upload; Python: perseuspy.pd.read_perseus(path)",
    "version": "2",
    "links": [
     {
      "label": "Perseus",
      "url": "https://maxquant.org/perseus/"
     }
    ],
    "group": "tool"
   },
   "levels": [
    "protein"
   ]
  },
  {
   "id": "apb-export:prolfqua",
   "label": "prolfqua (.h5ad)",
   "command": "apb-export",
   "name": "prolfqua",
   "extension": ".h5ad",
   "annotation": true,
   "fasta": true,
   "about": {
    "title": "prolfquapp",
    "file": ".h5ad",
    "what": "Wide peptidoform_ion table (peptides for MaxQuant) with protein groups and q-values; annotation columns become factors.",
    "open": "R: prolfquapp::LFQData_from_anndata(anndataR::read_h5ad(path))",
    "version": "2.11",
    "links": [
     {
      "label": "prolfqua/prolfquapp",
      "url": "https://github.com/prolfqua/prolfquapp"
     }
    ],
    "group": "tool"
   },
   "levels": [
    "peptide",
    "peptidoform_ion",
    "protein"
   ]
  },
  {
   "id": "apb-export:proteopy",
   "label": "proteopy (.h5ad)",
   "command": "apb-export",
   "name": "proteopy",
   "extension": ".h5ad",
   "annotation": true,
   "fasta": true,
   "about": {
    "title": "ProteoPy",
    "file": ".h5ad",
    "what": "Wide protein table with sample_id and protein_id.",
    "open": "anndata.read_h5ad(path)",
    "version": "0.1",
    "links": [
     {
      "label": "UKHD-NP/proteopy",
      "url": "https://github.com/UKHD-NP/proteopy"
     }
    ],
    "group": "tool"
   },
   "levels": [
    "protein"
   ]
  },
  {
   "id": "apb-export:qfeatures",
   "label": "qfeatures (.h5mu)",
   "command": "apb-export",
   "name": "qfeatures",
   "extension": ".h5mu",
   "annotation": true,
   "fasta": true,
   "about": {
    "title": "QFeatures",
    "file": ".h5mu",
    "what": "Ion, peptide and protein assays linked by their id columns.",
    "open": "R: MuData::readH5MU(path), then QFeatures with addAssayLink",
    "version": "1.22",
    "links": [
     {
      "label": "rformassspectrometry/QFeatures",
      "url": "https://github.com/rformassspectrometry/QFeatures"
     }
    ],
    "group": "tool"
   },
   "levels": [
    "peptidoform_ion",
    "peptide",
    "protein"
   ]
  },
  {
   "id": "apb-export:qpx",
   "label": "qpx (.qpx)",
   "command": "apb-export",
   "name": "qpx",
   "extension": ".qpx",
   "annotation": true,
   "fasta": true,
   "about": {
    "title": "pMultiQC / QPX",
    "file": "HTML report + QPX (zip)",
    "what": "Generate a pMultiQC quality report and download precursor and protein quantities as QPX Parquet tables. Sample groups are optional.",
    "open": "Open the generated report in a new tab, or download it with the QPX tables.",
    "version": "1.1",
    "links": [
     {
      "label": "pMultiQC",
      "url": "https://github.com/bigbio/pmultiqc"
     },
     {
      "label": "QPX",
      "url": "https://github.com/bigbio/qpx"
     }
    ],
    "group": "tool"
   },
   "levels": [
    "peptidoform_ion",
    "protein"
   ]
  },
  {
   "id": "apb2:hdf5",
   "label": "APB2 result: h5ad or h5mu",
   "command": "apb2",
   "name": "hdf5",
   "extension": "",
   "annotation": true,
   "fasta": true,
   "about": {
    "title": "AnnData / MuData",
    "file": ".h5ad or .h5mu",
    "what": "One AnnData per level, a MuData for several.",
    "open": "apb2.api.read_parsed_levels(path), or anndata / mudata",
    "version": null,
    "links": [
     {
      "label": "APB2 results",
      "url": "https://anndata-omics-bridge.github.io/apb2/result_io/"
     },
     {
      "label": "AnnData",
      "url": "https://anndata.readthedocs.io/"
     },
     {
      "label": "MuData",
      "url": "https://mudata.readthedocs.io/"
     }
    ],
    "group": "apb2"
   },
   "levels": []
  },
  {
   "id": "apb2:parquet",
   "label": "APB2 result: Parquet folder (zip)",
   "command": "apb2",
   "name": "parquet",
   "extension": "",
   "annotation": true,
   "fasta": true,
   "about": {
    "title": "Parquet",
    "file": ".parquet folder (zip)",
    "what": "Plain tables plus manifest.json; readable from any language.",
